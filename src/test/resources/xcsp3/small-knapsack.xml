<instance format="XCSP3" type="COP">
  <!--
    A tiny 3-item 0/1 knapsack, hand-authored for this test suite (not transcribed from an
    external XCSP3 benchmark repository) to exercise a sum condition plus a sum-type minimize
    objective end to end through Xcsp3Parser. Items have value=[3,4,5] and weight=[2,3,4]; the
    constraint requires total value >= 6. Optimal: x1=x2=1, x3=0 (value=7, weight=5).
  -->
  <variables>
    <var id="x1"> 0..1 </var>
    <var id="x2"> 0..1 </var>
    <var id="x3"> 0..1 </var>
  </variables>
  <constraints>
    <sum>
      <list> x1 x2 x3 </list>
      <coeffs> 3 4 5 </coeffs>
      <condition> (ge,6) </condition>
    </sum>
  </constraints>
  <objectives>
    <minimize type="sum">
      <list> x1 x2 x3 </list>
      <coeffs> 2 3 4 </coeffs>
    </minimize>
  </objectives>
</instance>
