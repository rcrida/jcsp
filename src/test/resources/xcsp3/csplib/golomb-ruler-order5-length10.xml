<instance format="XCSP3" type="COP">
  <!--
    Same real XCSP3 GolombRuler-05-a3 model as golomb-ruler-order5-length11.xml (see that file's
    comment for provenance), with the domain bound trimmed to 10 instead of 11, one below the
    known-optimal length, so that solving this file proves unsatisfiability: the other half of
    Prob006GolombRulerTest's classic satisfy-at-11-plus-unsat-at-10 optimality proof.
  -->
  <variables>
    <array id="x" note="x[i] is the position of the ith tick" size="[5]"> 0..10 </array>
    <array id="y" note="y[i] is the distance between x[i] and x[i+1]" size="[5][5]"> 1..10 </array>
  </variables>
  <constraints>
    <group class="channeling">
      <intension> eq(%0,add(%1,%2)) </intension>
      <args> x[1] x[0] y[0][1] </args>
      <args> x[2] x[0] y[0][2] </args>
      <args> x[3] x[0] y[0][3] </args>
      <args> x[4] x[0] y[0][4] </args>
      <args> x[2] x[1] y[1][2] </args>
      <args> x[3] x[1] y[1][3] </args>
      <args> x[4] x[1] y[1][4] </args>
      <args> x[3] x[2] y[2][3] </args>
      <args> x[4] x[2] y[2][4] </args>
      <args> x[4] x[3] y[3][4] </args>
    </group>
    <allDifferent> y[0][1..4] y[1][2..4] y[2][3..4] y[3][4] </allDifferent>
    <block class="symmetryBreaking">
      <intension> eq(x[0],0) </intension>
      <ordered>
        <list> x[] </list>
        <operator> lt </operator>
      </ordered>
    </block>
    <intension> lt(y[0][1],y[3][4]) </intension>
  </constraints>
  <objectives>
    <minimize> x[4] </minimize>
  </objectives>
</instance>
