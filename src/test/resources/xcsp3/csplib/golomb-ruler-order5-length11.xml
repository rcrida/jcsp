<instance format="XCSP3" type="COP">
  <!--
    Order-5 Golomb ruler ("a3" model), sourced from the real XCSP3 GolombRuler series
    (GolombRuler-05-a3.xml, https://www.cril.univ-artois.fr/~lecoutre/seriesSiteXCSP/GolombRuler.tgz
    per https://xcsp.org/instances/), with the domain bound trimmed from the competition-scale
    0..500 to the known-optimal length 11 (OEIS A003022) and one extra intension constraint
    appended (first gap less than last gap) to additionally break the mirror-reflection symmetry
    the original model leaves open, matching Prob006GolombRulerTest's own model exactly, so the
    known "exactly 2 rulers up to reflection" result still holds.
  -->
  <variables>
    <array id="x" note="x[i] is the position of the ith tick" size="[5]"> 0..11 </array>
    <array id="y" note="y[i] is the distance between x[i] and x[i+1]" size="[5][5]"> 1..11 </array>
  </variables>
  <constraints>
    <group class="channeling">
      <intension> eq(%0,add(%1,%2)) </intension>
      <args> x[1] x[0] y[0][1] </args>
      <args> x[2] x[0] y[0][2] </args>
      <args> x[3] x[0] y[0][3] </args>
      <args> x[4] x[0] y[0][4] </args>
      <args> x[2] x[1] y[1][2] </args>
      <args> x[3] x[1] y[1][3] </args>
      <args> x[4] x[1] y[1][4] </args>
      <args> x[3] x[2] y[2][3] </args>
      <args> x[4] x[2] y[2][4] </args>
      <args> x[4] x[3] y[3][4] </args>
    </group>
    <allDifferent> y[0][1..4] y[1][2..4] y[2][3..4] y[3][4] </allDifferent>
    <block class="symmetryBreaking">
      <intension> eq(x[0],0) </intension>
      <ordered>
        <list> x[] </list>
        <operator> lt </operator>
      </ordered>
    </block>
    <intension> lt(y[0][1],y[3][4]) </intension>
  </constraints>
  <objectives>
    <minimize> x[4] </minimize>
  </objectives>
</instance>
