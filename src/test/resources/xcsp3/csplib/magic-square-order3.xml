<instance format="XCSP3" type="CSP">
  <!--
    Order-3 magic square ("sum" model), sourced verbatim (no edits) from the real XCSP3
    MagicSquare series (MagicSquare-03-sum.xml,
    https://www.cril.univ-artois.fr/~lecoutre/seriesSiteXCSP/MagicSquare.tgz per
    https://xcsp.org/instances/).
  -->
  <variables>
    <array id="x" size="[3][3]"> 1..9 </array>
  </variables>
  <constraints>
    <allDifferent> x[][] </allDifferent>
    <group class="rows">
      <sum>
        <list> %... </list>
        <condition> (eq,15) </condition>
      </sum>
      <args> x[0][] </args>
      <args> x[1][] </args>
      <args> x[2][] </args>
    </group>
    <group class="columns">
      <sum>
        <list> %... </list>
        <condition> (eq,15) </condition>
      </sum>
      <args> x[][0] </args>
      <args> x[][1] </args>
      <args> x[][2] </args>
    </group>
    <group class="diagonals">
      <sum>
        <list> %... </list>
        <condition> (eq,15) </condition>
      </sum>
      <args> x[0][0] x[1][1] x[2][2] </args>
      <args> x[0][2] x[1][1] x[2][0] </args>
    </group>
  </constraints>
</instance>
